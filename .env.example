# Server
PORT=4000
JWT_SECRET=change-me

# Database (swap the in-memory mock store for this once ready)
DATABASE_URL=postgres://user:password@localhost:5432/solstice
# or: SUPABASE_URL=... / SUPABASE_ANON_KEY=...

# M-Pesa Daraja API (Safaricom)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.example.com/api/payments/mpesa/callback

# M-Pesa B2C (host & partner payouts) — separate Safaricom approval from STK Push
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_TIMEOUT_URL=https://your-domain.example.com/api/payments/mpesa/b2c-timeout
MPESA_B2C_RESULT_URL=https://your-domain.example.com/api/payments/mpesa/b2c-result

# Revenue model — Host-Only Commission (guest fee stays 0%)
HOST_COMMISSION_BASE=15
HOST_COMMISSION_PHOTOGRAPHED=12

# Localized Value-Added Services
PHOTOGRAPHY_FEE_KES=3500
FREE_PHOTOGRAPHY_COHORT_SIZE=50

# Double-blind reviews
REVIEW_REVEAL_WINDOW_DAYS=14

# Phase 3 — regional payment aggregator (Flutterwave shown; Pesapal is an alternative)
FLUTTERWAVE_SECRET_KEY=

# WhatsApp Business / Meta Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me
